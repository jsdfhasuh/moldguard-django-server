DJANGO_DEBUG=true
DJANGO_SECRET_KEY=demo-only-change-me
DJANGO_ALLOWED_HOSTS=*
DJANGO_DB_PATH=db.sqlite3
DJANGO_DB_ENGINE=sqlite
# MariaDB deployment values are consumed by compose.yaml. Use long random values.
MARIADB_DATABASE=moldguard
MARIADB_USER=moldguard
MARIADB_PASSWORD=replace-with-a-long-random-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-random-password
PROBE_EMPLOYEE_1_EMAIL=maintainer-injection@example.com
PROBE_EMPLOYEE_2_EMAIL=maintainer-sheet@example.com
PROBE_EMPLOYEE_4_EMAIL=maintainer-shared@example.com
